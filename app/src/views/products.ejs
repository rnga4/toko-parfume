<%- include('header') %>
<h2>Produk</h2>
<% if (error) { %>
<div class="alert" role="alert" tabindex="-1"><%= error %></div>
<% } %>
<% if (canManage) { %>
<div class="card">
  <h3>Tambah produk</h3>
  <form method="post" action="/products">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="form-grid">
      <label><span>SKU</span><input name="sku" value="<%= form.sku || '' %>" required></label>
      <label><span>Brand</span><input name="brand" value="<%= form.brand || '' %>" required></label>
      <label><span>Nama</span><input name="name" value="<%= form.name || '' %>" required></label>
      <label><span>Kategori</span><select name="category">
        <% categories.forEach(c => { %>
        <option<%= (form.category || 'EDP') === c ? ' selected' : '' %>><%= c %></option>
        <% }) %>
      </select></label>
      <label><span>Ukuran (ml)</span><input name="size_ml" type="number" inputmode="numeric" min="1" value="<%= form.size_ml || '' %>" required></label>
      <label><span>Harga beli (Rp)</span><input name="cost_price" type="number" inputmode="numeric" min="0" value="<%= form.cost_price || '' %>" required></label>
      <label><span>Harga jual (Retail, Rp)</span><input name="sell_price" type="number" inputmode="numeric" min="0" value="<%= form.sell_price || '' %>" required></label>
      <label><span>Harga reseller (Rp)</span><input name="price_reseller" type="number" inputmode="numeric" min="0" value="<%= form.price_reseller || 0 %>"></label>
      <label><span>Harga agen (Rp)</span><input name="price_agen" type="number" inputmode="numeric" min="0" value="<%= form.price_agen || 0 %>"></label>
      <label><span>Harga grosir (Rp)</span><input name="price_grosir" type="number" inputmode="numeric" min="0" value="<%= form.price_grosir || 0 %>"></label>
      <label><span>Stok (opsional)</span><input name="stock" type="number" inputmode="numeric" min="0" value="<%= form.stock || '' %>"></label>
      <label><span>Stok minimum (opsional)</span><input name="min_stock" type="number" inputmode="numeric" min="0" value="<%= form.min_stock || '' %>"></label>
      <label><span>Nomor batch (opsional)</span><input name="batch_no" value="<%= form.batch_no || '' %>"></label>
      <label><span>Tanggal kedaluwarsa (opsional)</span><input name="expiry_date" type="date" value="<%= form.expiry_date || '' %>"></label>
      <label><span>Produk induk</span><select name="parent_product_id">
        <option value="">Tanpa induk</option>
        <% parents.forEach(p => { %>
        <option value="<%= p.id %>"<%= String(form.parent_product_id) === String(p.id) ? ' selected' : '' %>><%= p.brand %> <%= p.name %> <%= p.size_ml %>ml</option>
        <% }) %>
      </select></label>
      <label><span>QC required</span><input type="checkbox" name="qc_required" <%= form.qc_required ? 'checked' : '' %> style="width:auto;min-height:unset"></label>
      <button>Tambah</button>
    </div>
  </form>
</div>
<% } %>
<div class="card">
  <h3>Daftar Produk</h3>
  <% if (products.length) { %>
  <table class="stack">
    <thead>
      <tr><th scope="col">SKU</th><th scope="col">Produk</th><th scope="col">Kategori</th><th scope="col" class="num">Ukuran</th><th scope="col" class="num">Beli</th><th scope="col" class="num">Jual</th><th scope="col" class="num">Stok</th><% if (canManage) { %><th scope="col" aria-label="Aksi"></th><% } %></tr>
    </thead>
    <tbody>
    <% products.forEach(p => { %>
      <tr>
        <td data-label="SKU"><%= p.sku %></td>
        <td data-label="Produk"><%= p.brand %> <%= p.name %><% if (!p.is_active) { %> <span class="muted">Nonaktif</span><% } %><% if (p.batch_no || p.expiry_str) { %><br><span class="muted<%= p.expiry_str && p.expiry_str <= today ? ' warn' : '' %>"><% if (p.batch_no) { %>Batch <%= p.batch_no %><% } %><% if (p.batch_no && p.expiry_str) { %>, <% } %><% if (p.expiry_str) { %>kedaluwarsa <%= p.expiry_str %><% } %></span><% } %></td>
        <td data-label="Kategori"><%= p.category %></td>
        <td data-label="Ukuran" class="num"><%= p.size_ml %>ml<% if (p.ml_used > 0) { %><br><span class="muted">sisa <%= p.ml_left %>ml</span><% } %></td>
        <td data-label="Beli" class="num"><%= rp(p.cost_price) %></td>
        <td data-label="Jual" class="num"><%= rp(p.sell_price) %></td>
        <td data-label="Stok" class="num"><%= p.stock %><% if (p.is_active && p.stock <= p.min_stock) { %> <span class="warn">menipis</span><% } %></td>
        <% if (canManage) { %>
        <td class="actions">
          <a class="btn" href="/products/<%= p.id %>/edit" aria-label="Ubah <%= p.brand %> <%= p.name %>">Ubah</a>
          <% if (p.is_active) { %>
          <form method="post" action="/products/<%= p.id %>/delete" onsubmit="return confirm('Nonaktifkan produk ini? Produk lama yang sudah terjual tetap tersimpan.')">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="danger" aria-label="Nonaktifkan <%= p.brand %> <%= p.name %>">Nonaktifkan</button>
          </form>
          <% } else { %>
          <form method="post" action="/products/<%= p.id %>/restore">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button aria-label="Aktifkan <%= p.brand %> <%= p.name %>">Aktifkan</button>
          </form>
          <% } %>
        </td>
        <% } %>
      </tr>
    <% }) %>
    </tbody>
  </table>
  <% } else { %>
  <p class="state">Belum ada produk tercatat di database.</p>
  <% if (canManage) { %>
  <p class="state">Isi form di atas untuk menambah produk pertama.</p>
  <% } %>
  <% } %>
</div>
<%- include('footer') %>
