<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#1f1f2e">
<meta name="color-scheme" content="light">
<link rel="icon" href="data:,">
<title>ERP Toko Parfum</title>
<style>
  *{box-sizing:border-box}
  :root{color-scheme:light}
  body{font-family:system-ui,sans-serif;margin:0;background:#f5f5f7;color:#222;-webkit-text-size-adjust:100%}
  nav{background:#1f1f2e;position:sticky;top:0;z-index:10}
  .navrow{display:flex;gap:8px;padding:0 8px;overflow-x:auto}
  .bottombar{display:none}
  nav a,nav button{color:#fff;text-decoration:none;padding:14px 12px;white-space:nowrap}
  nav a{display:block}
  nav form{margin:0}
  nav button{background:none;border:0;font:inherit;font-size:16px;cursor:pointer;min-height:44px}
  summary{list-style:none;cursor:pointer}
  summary::-webkit-details-marker{display:none}
  summary:focus-visible{outline:3px solid #fff;outline-offset:-3px}
  main{max-width:1000px;margin:16px auto;padding:0 12px}
  h2{margin:8px 0 12px}
  h3{margin:0 0 12px;font-size:16px}
  .card{background:#fff;border-radius:10px;padding:16px;margin-bottom:16px;box-shadow:0 1px 3px #0001}
  .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px}
  .grid .card{margin-bottom:0}
  .grid-split{grid-template-columns:1fr;margin-bottom:16px}
  .form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px;align-items:end}
  .form-grid.one{grid-template-columns:1fr}
  .narrow{max-width:420px}
  .actions-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
  .actions-row button{flex:1 1 140px}
  .mt{margin-top:16px}
  .toolbar{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 16px}
  .inline-form{display:flex;align-items:center;justify-content:flex-end;gap:6px;margin:0}
  .inline-form input{width:96px}
  .inline-form button{padding:10px 12px;white-space:nowrap}
  .cell-stack{display:flex;flex-direction:column;gap:8px;margin:0;min-width:190px}
  .cell-form{display:flex;flex-direction:column;gap:6px;margin:0}
  .cell-form button{width:100%}
  td a{display:inline-flex;align-items:center;min-height:44px}
  dd a{display:inline-flex;align-items:center;min-height:44px}
  table{width:100%;border-collapse:collapse}
  th,td{padding:8px;border-bottom:1px solid #eee;text-align:left}
  th.num,td.num{text-align:right;font-variant-numeric:tabular-nums}
  input,select,button{font-size:16px;padding:10px;border-radius:8px;border:1px solid #8a8a8a;font-family:inherit}
  input,select{width:100%;background:#fff;min-height:44px}
  button,.btn{background:#1f1f2e;color:#fff;border:0;cursor:pointer;min-height:44px;padding:12px 16px;border-radius:8px;display:inline-block;text-decoration:none;font-size:16px;line-height:20px;text-align:center}
  button.danger{background:#c0392b}
  button:active,.btn:active{background:#161624}
  button.danger:active{background:#a53124}
  button.link{background:none;border:0;color:#1f1f2e;text-decoration:underline;padding:10px 0;min-height:44px;font-family:inherit;font-size:16px;cursor:pointer}
  .warn{color:#c0392b;font-weight:600}
  .muted{color:#666}
  .stat-lead h3{font-size:28px;font-weight:700}
  .stat h3{font-size:20px;font-weight:600;margin:4px 0 0}
  .alert{background:#fdecea;border:1px solid #c0392b;color:#7a1f16;border-radius:8px;padding:12px 16px;margin:0 0 16px}
  .flash{background:#fff;border:1px solid #1f1f2e;color:#1f1f2e;border-radius:8px;padding:12px 16px;margin:0 0 16px}
  .state{color:#666;margin:0 0 12px}
  .sums{margin:0 0 16px;padding:0}
  .sums>div{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:8px 0;border-bottom:1px solid #eee}
  .sums dt{color:#666;margin:0}
  .sums dd{margin:0;font-weight:600;font-variant-numeric:tabular-nums}
  .sums .total{border-bottom:0;padding-top:12px}
  .sums .total dt{color:#222;font-weight:600}
  .sums .total dd{font-size:28px;font-weight:700;line-height:1.2}
  .qty-form{display:inline-flex;align-items:center;gap:4px;margin:0}
  .qty-input{max-width:110px;margin-left:auto}
  .qty-form button{min-width:44px;min-height:44px;padding:0;font-size:18px;line-height:1}
  .qty-value{min-width:2.5ch;text-align:center;font-variant-numeric:tabular-nums;font-weight:600}
  .row-form{margin:0}
  a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #1f1f2e;outline-offset:2px}
  nav a:focus-visible,nav button:focus-visible{outline-color:#fff}
  button,.btn,input,select,nav a,nav button{transition:background-color .15s ease,color .15s ease,outline-color .15s ease}
  @media (min-width:900px) and (max-width:1140px){
    .navrow{gap:4px}
    .navrow a,.navrow button{padding:14px 8px}
  }
  @media (max-width:899px){
    .navrow{display:none}
    .bottombar{display:flex;align-items:stretch;position:fixed;left:0;right:0;bottom:0;z-index:10;background:#1f1f2e;padding:0 4px env(safe-area-inset-bottom)}
    .bottombar a,.bottombar>form button{display:flex;align-items:center;justify-content:center;text-align:center;flex:1 1 0;min-width:0;min-height:52px;padding:0 6px;font-size:14px;white-space:nowrap}
    .bottombar>form{display:flex;flex:1 1 0;margin:0}
    .bottombar>form button{width:100%}
    .menu{position:relative;flex:0 0 auto;display:flex}
    .menu>summary{display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;padding:0 14px;min-height:52px;white-space:nowrap}
    .menu[open]>summary{background:#161624}
    .drawer{position:absolute;right:0;bottom:100%;margin-bottom:6px;width:min(70vw,240px);background:#1f1f2e;border:1px solid #0004;border-radius:10px;padding:4px;display:flex;flex-direction:column}
    .drawer a{display:flex;align-items:center;min-height:44px;padding:12px 10px;border-radius:8px}
    .drawer form{margin:0}
    .drawer form button{width:100%;text-align:left;min-height:44px;padding:12px 10px;border-radius:8px}
    main{padding-bottom:calc(76px + env(safe-area-inset-bottom))}
  }
  @media (min-width:700px){
    .grid{grid-template-columns:2fr 1fr 1fr 1fr}
    .grid-split{grid-template-columns:2fr 1fr}
  }
  @media (max-width:640px){
    main{margin:12px auto}
    .card{padding:12px}
    table.stack thead{display:none}
    table.stack,table.stack tbody{display:block}
    table.stack tr{display:block;border:1px solid #eee;border-radius:8px;margin-bottom:10px;padding:6px 12px}
    table.stack td{display:flex;justify-content:space-between;align-items:center;gap:12px;border:0;padding:6px 0;text-align:right}
    table.stack td::before{content:attr(data-label);font-weight:600;color:#666;text-align:left}
    table.stack td.actions{justify-content:flex-end}
    table.stack td.actions::before{content:none}
    table.stack td.no-label::before{content:none}
    .sums .total dd{font-size:24px}
  }
  @media (prefers-reduced-motion:reduce){
    button,.btn,input,select,nav a,nav button{transition:none}
  }
</style>
</head>
<body>
<% if (user) { %>
<nav>
  <div class="navrow">
    <a href="/">Dashboard</a>
    <a href="/kasir">Kasir</a>
    <a href="/sales">Riwayat</a>
    <a href="/products">Produk</a>
    <% if (user.role === 'admin') { %>
    <a href="/purchases">Pembelian</a>
    <a href="/suppliers">Supplier</a>
    <a href="/returns">Retur</a>
    <a href="/decants">Decant</a>
    <a href="/opnames">Opname</a>
    <a href="/users">Akun</a>
    <% } %>
    <form method="post" action="/logout">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button type="submit">Keluar</button>
    </form>
  </div>
  <div class="bottombar">
    <a href="/">Dashboard</a>
    <a href="/kasir">Kasir</a>
    <a href="/sales">Riwayat</a>
    <a href="/products">Produk</a>
    <% if (user.role === 'admin') { %>
    <details class="menu">
      <summary>Menu</summary>
      <div class="drawer">
        <a href="/purchases">Pembelian</a>
        <a href="/suppliers">Supplier</a>
        <a href="/returns">Retur</a>
        <a href="/decants">Decant</a>
        <a href="/opnames">Opname</a>
        <a href="/users">Akun</a>
        <form method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button type="submit">Keluar</button>
        </form>
      </div>
    </details>
    <% } else { %>
    <form method="post" action="/logout">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button type="submit">Keluar</button>
    </form>
    <% } %>
  </div>
</nav>
<% } %>
<main>
