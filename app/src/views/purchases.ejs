<%- include('header') %>
<h2>Pembelian</h2>
<% if (flash) { %>
<div class="flash" role="status"><%= flash %></div>
<% } %>

<div class="toolbar">
  <a class="btn" href="/purchases/new">Buat pembelian baru</a>
</div>

<div class="card">
  <h3>Daftar pembelian</h3>
  <% if (!purchases.length) { %>
  <p class="state">Belum ada pembelian tercatat. Tekan "Buat pembelian baru" untuk mencatat stok masuk.</p>
  <% } else { %>
  <table class="stack">
    <thead>
      <tr>
        <th scope="col">Nomor</th>
        <th scope="col">Waktu</th>
        <th scope="col">Supplier</th>
        <th scope="col">Pencatat</th>
        <th scope="col" class="num">Item</th>
        <th scope="col" class="num">Total</th>
      </tr>
    </thead>
    <tbody>
      <% purchases.forEach(p => { %>
      <tr>
        <td data-label="Nomor"><a href="/purchases/<%= p.id %>"><%= p.invoice_no || ('Pembelian #' + p.id) %></a></td>
        <td data-label="Waktu" class="muted"><%= new Date(p.created_at).toLocaleString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
        <td data-label="Supplier"><%= p.supplier || '-' %></td>
        <td data-label="Pencatat"><%= p.username || '-' %></td>
        <td data-label="Item" class="num"><%= p.items %></td>
        <td data-label="Total" class="num"><%= rp(p.total) %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
<%- include('footer') %>
