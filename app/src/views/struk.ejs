<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>Struk <%= sale.invoice_no %></title>
<style>
  *{box-sizing:border-box}
  body{font-family:system-ui,sans-serif;margin:0;background:#f5f5f7;color:#222;-webkit-text-size-adjust:100%}
  .sheet{max-width:480px;margin:24px auto;background:#fff;border:1px solid #ddd;border-radius:10px;padding:20px}
  h1{font-size:18px;margin:0 0 4px;text-align:center}
  .shop{font-size:14px;color:#666;text-align:center;margin:0 0 16px}
  .meta{font-size:14px;margin:0 0 12px}
  .meta div{display:flex;justify-content:space-between;gap:12px;padding:3px 0}
  .meta span:last-child{font-variant-numeric:tabular-nums;text-align:right}
  table{width:100%;border-collapse:collapse;font-size:14px}
  th,td{padding:6px 4px;text-align:left;border-bottom:1px dashed #ccc;vertical-align:top}
  th.num,td.num{text-align:right;font-variant-numeric:tabular-nums}
  thead th{border-bottom:1px solid #333}
  .sums{margin:12px 0 0;font-size:14px}
  .sums div{display:flex;justify-content:space-between;gap:12px;padding:4px 0}
  .sums span:last-child{font-variant-numeric:tabular-nums}
  .sums .grand{border-top:1px solid #333;margin-top:6px;padding-top:8px;font-weight:700;font-size:16px}
  .thanks{font-size:13px;color:#666;text-align:center;margin:16px 0 0}
  .controls{max-width:480px;margin:0 auto 24px;padding:0 12px}
  .controls p{font-size:14px;color:#666}
  .btn{display:inline-block;background:#1f1f2e;color:#fff;border:0;cursor:pointer;min-height:44px;padding:12px 16px;border-radius:8px;text-decoration:none;font-size:16px;line-height:20px;text-align:center;margin:0 8px 8px 0}
  a:focus-visible{outline:3px solid #1f1f2e;outline-offset:2px}
  @media print{
    body{background:#fff}
    .sheet{border:0;border-radius:0;margin:0;max-width:none;padding:0}
    .controls{display:none}
  }
</style>
</head>
<body>
<div class="sheet">
  <h1>Toko Parfum</h1>
  <p class="shop">Struk pembelian</p>
  <div class="meta">
    <div><span>Invoice</span><span><%= sale.invoice_no %></span></div>
    <div><span>Tanggal</span><span><%= new Date(sale.created_at).toLocaleString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span></div>
    <div><span>Kasir</span><span><%= sale.username || '-' %></span></div>
    <% if (sale.customer) { %><div><span>Pelanggan</span><span><%= sale.customer %></span></div><% } %>
  </div>
  <table>
    <thead>
      <tr>
        <th scope="col">Produk</th>
        <th scope="col" class="num">Qty</th>
        <th scope="col" class="num">Harga</th>
        <th scope="col" class="num">Jumlah</th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(i => { %>
      <tr>
        <td><%= i.brand %> <%= i.name %> <%= i.size_ml %>ml</td>
        <td class="num"><%= i.qty %></td>
        <td class="num"><%= rp(i.price) %></td>
        <td class="num"><%= rp(i.price * i.qty) %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <div class="sums">
    <div><span>Subtotal</span><span><%= rp(sale.subtotal) %></span></div>
    <% if (sale.discount) { %><div><span>Diskon</span><span><%= rp(sale.discount) %></span></div><% } %>
    <div class="grand"><span>Total</span><span><%= rp(sale.total) %></span></div>
    <div><span>Metode bayar</span><span><%= paymentLabel %></span></div>
    <% if (sale.payment_method === 'tempo') { %>
    <div><span>Status</span><span><%= sale.paid_at ? 'Lunas' : 'Belum lunas' %></span></div>
    <% if (sale.due_date) { %><div><span>Jatuh tempo</span><span><%= new Date(sale.due_date).toLocaleDateString('id-ID') %></span></div><% } %>
    <% } %>
  </div>
  <p class="thanks">Terima kasih sudah berbelanja.</p>
</div>
<div class="controls">
  <a class="btn" href="/sales/<%= sale.id %>">Kembali ke detail</a>
  <% if (waHref) { %>
  <a class="btn" href="<%= waHref %>" target="_blank" rel="noopener">Kirim ke WhatsApp</a>
  <% } %>
  <p>Tekan Ctrl+P (Cmd+P di Mac) untuk mencetak atau menyimpan sebagai PDF.<% if (!waHref) { %> Tambahkan nomor HP pelanggan supaya struk bisa dikirim lewat WhatsApp.<% } %></p>
</div>
</body>
</html>
